{
  "name": "scenedetect-rs",
  "private": true,
  "scripts": {
    "prepack": "echo 'This repository root is not publishable.' >&2; exit 1",
    "tdd:rust": "cargo test --workspace",
    "tdd:core": "cargo test -p scenedetect-core",
    "tdd:cli": "cargo test -p scenedetect-cli --test cli",
    "tdd:parity": "tests/parity/run-all.sh",
    "tdd:local-oracle": "tests/local-oracle/test-runner.sh && python3 tests/local-oracle/test-formats.py && python3 tests/local-oracle/test-surfaces.py",
    "tdd:site": "python3 scripts/update-site-benchmarks.py --check-fixture && python3 scripts/check-site.py",
    "tdd:fmt": "cargo fmt --all -- --check",
    "tdd:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "tdd:check": "bun run tdd:fmt && bun run tdd:lint && cargo test --workspace && bun run tdd:local-oracle && bun run tdd:parity && bun run tdd:site",
    "oracle:refresh": "tests/local-oracle/run.py refresh",
    "oracle:check": "python3 tests/local-oracle/check.py",
    "oracle:check-surfaces": "python3 tests/local-oracle/check-surfaces.py",
    "oracle:verify": "tests/local-oracle/run.py verify",
    "agent:check": "bun run tdd:check",
    "agent:eval": "scripts/moonlight.sh eval run --project moonlight.eval.toml --storage-path .moonlight/agent-runs.jsonl --format markdown",
    "agent:eval:report": "scripts/moonlight.sh eval report --storage-path .moonlight/agent-runs.jsonl --format markdown"
  },
  "devDependencies": {
    "@moritzbrantner/moonlight": "^0.1.2"
  },
  "lint-staged": {
    "*.{json,md,toml,yml,yaml}": "prettier --ignore-unknown --write",
    "*.rs": "sh -c 'cargo fmt --all'"
  }
}
